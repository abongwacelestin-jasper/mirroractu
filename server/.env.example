# MirrorActu API settings. On Railway set these under the api service's Variables; with Docker
# Compose put them in the project's .env file. Never commit real values.

# ---------- Required ----------
DATABASE_URL=postgres://mirroractu:password@db:5432/mirroractu
NODE_ENV=production
# Public address of the website. Several may be given, comma separated.
SITE_ORIGIN=https://mirroractu.net
# Long random string:  openssl rand -base64 32
ANALYTICS_SALT=
# Public address of the staff dashboard. It is a separate website and must differ from SITE_ORIGIN.
ADMIN_ORIGIN=https://desk.mirroractu.net
# Long random string (32+ characters) shared ONLY with the dashboard's web service:
#   openssl rand -hex 32
# Sign-in and dashboard requests without it are answered "not found".
ADMIN_GATEWAY_KEY=

# ---------- Cache ----------
# Redis connection string. Optional: without it each API instance caches in its own memory.
# On Railway: ${{Redis.REDIS_URL}}
REDIS_URL=

# ---------- Staff accounts, created automatically on every start ----------
# Administrators and editors. Names are optional: "Ada Obi <ada@example.com>, sam@example.com"
ADMIN_EMAILS=
EDITOR_EMAILS=
# First password for accounts created from the lists above (12+ characters).
# Everyone must choose their own at first sign-in, so this is only ever used once per person.
ADMIN_PASSWORD=
# Locked out? Set to true and restart: the listed accounts go back to ADMIN_PASSWORD. Then remove it.
ADMIN_FORCE_RESET=

# ---------- Optional tuning (defaults shown) ----------
PORT=4000
SESSION_DAYS=7
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=300
EVENTS_RETENTION_DAYS=90
# false starts with an empty site instead of loading the bundled snapshot
SEED_CONTENT=true
# fatal | error | warn | info | debug
LOG_LEVEL=info

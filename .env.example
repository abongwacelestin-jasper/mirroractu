# Google's public sample video advert, so the pre-roll can be seen working in development.
# It is a test tag from Google's IMA SDK documentation and earns nothing.
# For production set VITE_IMA_AD_TAG to your own Google Ad Manager tag. The tag must end with
# "correlator=" because the player appends a cache-busting number.
VITE_IMA_AD_TAG=

# Google AdSense display adverts. Leave empty to keep the placeholder adverts.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_MPU=
VITE_ADSENSE_SLOT_HALFPAGE=
VITE_ADSENSE_SLOT_INFEED=

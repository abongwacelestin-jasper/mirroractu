# Copy this file to .env in the project folder (next to docker-compose.yml), fill it in, then run:
#   docker compose up -d --build
# Never commit the real .env file: it holds passwords.

# ---------- Required on a real server ----------

# Port on the server that the site is published on.
PORT=8080

# "production" switches on secure (HTTPS-only) sign-in cookies. Use it whenever the site is served over HTTPS.
NODE_ENV=production

# The public address of the site. Requests that change data are only accepted from here.
SITE_ORIGIN=https://mirroractu.net

# The staff dashboard is a separate website. Its public address, and the port it is published on.
ADMIN_ORIGIN=https://desk.mirroractu.net
ADMIN_PORT=8081
# The public site's address, for the dashboard's "View the site" links.
SITE_URL=https://mirroractu.net
# Long random string (32+ characters) shared by the API and the dashboard's web server only:
#   openssl rand -hex 32
ADMIN_GATEWAY_KEY=

# Database password. Use a long random string, e.g. the output of:  openssl rand -base64 32
POSTGRES_PASSWORD=

# Staff accounts, created automatically each time the API starts. Names are optional:
#   ADMIN_EMAILS=Ada Obi <ada@example.com>, sam@example.com
ADMIN_EMAILS=
EDITOR_EMAILS=
# First password for accounts created from those lists (12+ characters). Each person must
# choose their own at first sign-in.
ADMIN_PASSWORD=
# Locked out? Set to true, restart, sign in with ADMIN_PASSWORD, then remove this line.
ADMIN_FORCE_RESET=

# Any long random string. It anonymises readers in readership counts. Keep it private.
#   openssl rand -base64 32
ANALYTICS_SALT=

# ---------- Optional ----------

# API tuning (defaults shown). The full list is in server/.env.example.
SESSION_DAYS=7
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15

# Google AdSense display adverts: publisher id and one ad unit id per format.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_MPU=
VITE_ADSENSE_SLOT_HALFPAGE=
VITE_ADSENSE_SLOT_INFEED=

# Google Ad Manager video ad tag (VAST) for the pre-roll. It must end with "correlator=".
VITE_IMA_AD_TAG=

# Optional geo lookup URL returning JSON with "country_code". Not needed if a CDN or proxy in
# front of the container sends the reader's country (see deploy/nginx.conf.template).
VITE_GEO_ENDPOINT=

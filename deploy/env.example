

# ---------- Trending on the web (Google Trends, GDELT, Wikimedia) ----------
# On by default, with nothing to set. "off" stops all fetching.
WEB_TRENDS=
# Which sources to use, comma separated. Default: google,gdelt,wikimedia
# Google's feed is free but undocumented: remove "google" here to stop using it.
WEB_TRENDS_SOURCES=
# How the fetcher names itself to those services. Wikimedia asks for a name with a way to
# reach you, for example: MirrorActu/1.0 (https://yourdomain)
WEB_TRENDS_USER_AGENT=
# Most requests per day to each source. Defaults: 1500, 1200, 200.
WEB_TRENDS_BUDGET_GOOGLE=
WEB_TRENDS_BUDGET_GDELT=
WEB_TRENDS_BUDGET_WIKIMEDIA=

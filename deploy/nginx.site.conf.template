# MirrorActu web server for the PUBLIC SITE.
#
# The staff dashboard is a different website with its own server (nginx.admin.conf.template).
# This one refuses every sign-in and dashboard request, so there is no way into the dashboard
# from the public address.
#
# This is a template: on start-up the nginx image replaces ${PORT} with the PORT environment
# variable, ${API_UPSTREAM} with the address of the API service, and ${NGINX_LOCAL_RESOLVERS}
# with the container's DNS server, and writes the result to /etc/nginx/conf.d/default.conf.
#
# The site is a single-page app: every address that is not a real file (a story, a section,
# a language prefix such as /fr/trends) is answered with index.html and the app takes it
# from there.

# The reader's country, if a proxy or CDN in front of this container supplies it.
# Cloudflare sends CF-IPCountry; Vercel-style proxies send X-Vercel-IP-Country; or set your
# own X-Country-Code header on the load balancer. Empty when none is present, and the site
# then falls back to the device's time zone.
map $http_cf_ipcountry $country_cf      { default $http_cf_ipcountry; "XX" ""; "T1" ""; }
map $http_x_vercel_ip_country $country_v { default $http_x_vercel_ip_country; }
map $http_x_country_code $country_x     { default $http_x_country_code; }
map "$country_x$country_cf$country_v" $ma_country {
  default "";
  "~^(?<cc>[A-Za-z]{2})" $cc;
}

server {
  # ${PORT} is filled in when the container starts. Hosts such as Railway choose the port
  # themselves and pass it in; everywhere else it is 8080.
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  # /usr/share/nginx/site or /usr/share/nginx/admin, set by deploy/start.sh.
  root ${WEB_ROOT};
  index index.html;

  # Do not advertise the server version.
  server_tokens off;

  # ---------- Compression ----------
  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_types text/plain text/css application/javascript application/json application/xml application/rss+xml image/svg+xml;

  # ---------- Security headers ----------
  # (No Content-Security-Policy here: the site may load Google Translate, Google adverts and
  # Google Fonts when a reader allows them. Add one at the CDN once the ad setup is final.)
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), geolocation=(), payment=(), microphone=(self)" always;

  # ---------- Health check ----------
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # ---------- The API ----------
  # Requests to /api/ go to the API service, so the site and its API share one address and
  # sign-in cookies never cross sites. The address is resolved when used, not at start-up,
  # so the web container starts even if the API is still coming up.
  # Sign-in and the dashboard API do not exist on the public site.
  location ~ ^/api/v1/(admin|auth)(/|$) {
    default_type application/json;
    return 404 '{"error":"Not found."}';
  }

  location /api/ {
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header Connection "";
    # Never pass on a gateway key supplied by a visitor.
    proxy_set_header X-Admin-Gateway-Key "";
    # The live wire is a long-lived stream: do not buffer it or cut it off.
    proxy_buffering off;
    proxy_read_timeout 1h;
    client_max_body_size 64k;
    proxy_intercept_errors on;
    error_page 502 503 504 = @api_down;
  }
  location @api_down {
    default_type application/json;
    return 503 '{"error":"The MirrorActu API is not reachable."}';
  }

  # ---------- Built assets ----------
  # File names contain a content hash, so they can be cached for a year.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # ---------- Photographs and video ----------
  # Names are stable, so cache for a week. Range requests let video seek.
  location /media/ {
    add_header Cache-Control "public, max-age=604800" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # ---------- Installable app ----------
  # The service worker and manifest must always be the latest, or installs would never update.
  location = /sw.js {
    add_header Cache-Control "no-cache" always;
    add_header Service-Worker-Allowed "/" always;
    add_header X-Content-Type-Options "nosniff" always;
  }
  location = /manifest.webmanifest {
    default_type application/manifest+json;
    types { }
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
  }
  location /icons/ {
    add_header Cache-Control "public, max-age=604800" always;
    try_files $uri =404;
  }
  location /brand/ {
    add_header Cache-Control "public, max-age=86400" always;
    try_files $uri =404;
  }

  location = /favicon.svg {
    add_header Cache-Control "public, max-age=604800" always;
  }

  # ---------- The app ----------
  # index.html must never be cached, or readers would keep an old build after a deploy.
  location / {
    try_files $uri /index.html;
  }

  # ---------- Search engines and link previews ----------
  # robots.txt, the sitemaps and the RSS feed are written by the API from what is published.
  location ~ ^/(robots\.txt|sitemap\.xml|news-sitemap\.xml|feed\.xml)$ {
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $api_upstream ${API_UPSTREAM};
    rewrite ^/(.*)$ /api/v1/seo/$1 break;
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header X-Admin-Gateway-Key "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 10s;
  }

  # The page asks for its own title, description, share tags and structured data here, and
  # for a plain-HTML copy of its content (see the two "include" lines in index.html). Only
  # nginx itself can use this address. If the API is slow or down, the page is sent with its
  # built-in defaults instead: a page view never waits on this for more than two seconds.
  location /__seo/ {
    internal;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $api_upstream ${API_UPSTREAM};
    rewrite ^/__seo/(.*)$ /api/v1/seo/$1 break;
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header Accept-Encoding "";
    proxy_set_header X-Admin-Gateway-Key "";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_connect_timeout 1s;
    proxy_read_timeout 2s;
    proxy_intercept_errors on;
    error_page 400 404 429 500 502 503 504 = @seo_none;
  }
  location @seo_none {
    internal;
    return 204;
  }

  location = /index.html {
    # Lets the page pull in the fragments from /__seo/ above.
    ssi on;
    ssi_silent_errors on;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), payment=(), microphone=(self)" always;

    # Hand the reader's country to the app (src/lib/edition.ts reads this tag).
    sub_filter '</head>' '<meta name="ma-country" content="$ma_country"></head>';
    sub_filter_once on;
  }
}
